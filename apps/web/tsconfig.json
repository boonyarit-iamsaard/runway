{
  "extends": "@runway/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/typescript/tsconfig.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
